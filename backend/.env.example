# ===== AI =====
# Nhà cung cấp mặc định: auto | anthropic | openai | gemini | offline
# auto = dùng nhà cung cấp đầu tiên có API key (Claude → OpenAI → Gemini), không có thì offline
FEEDLENS_AI_PROVIDER=auto

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ChatGPT (OpenAI). OPENAI_BASE_URL để dùng server tương thích OpenAI (tùy chọn)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Chế độ chạy =====
# local: điều khiển Chrome trên máy này. cloud: không có trình duyệt, nhận bài qua /api/ingest
FEEDLENS_MODE=local
# Bắt buộc ở cloud; ở local, đặt mật khẩu thì web cũng yêu cầu đăng nhập
FEEDLENS_PASSWORD=
FEEDLENS_SECRET=
FEEDLENS_API_TOKEN=
# Dùng cho `feedlens push`
FEEDLENS_SERVER=

# ===== Database =====
# Bỏ trống => SQLite tại backend/data/feedlens.db
# Postgres (xem docker-compose.yml): postgresql+psycopg://feedlens:feedlens@localhost:5432/feedlens
DATABASE_URL=

# ===== Trình duyệt =====
FEEDLENS_BROWSER_CHANNEL=chrome
FEEDLENS_MAX_POSTS=300
FEEDLENS_DATA_DIR=
