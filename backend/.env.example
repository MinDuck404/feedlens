# ===== Chế độ chạy =====
# local: một người dùng, điều khiển Chrome trên chính máy này (không cần đăng nhập web)
# cloud: nhiều tài khoản; server không có trình duyệt, việc lướt do `feedlens agent` trên máy từng user đảm nhận
FEEDLENS_MODE=local

# Khóa ký phiên đăng nhập + mã hóa API key của user. Bắt buộc ở cloud (>= 32 ký tự).
# Ở local bỏ trống thì tự sinh và lưu trong data/secret.key. ĐỪNG đổi sau khi đã có user.
FEEDLENS_SECRET=
# cloud: cho phép đăng ký tài khoản mới
FEEDLENS_ALLOW_SIGNUP=true
# cloud: origin của frontend, phân tách bằng dấu phẩy
FEEDLENS_CORS=http://localhost:5173

# ===== AI =====
# Ở cloud, mỗi user tự nhập API key trên web (mã hóa trong DB); các key dưới đây bị bỏ qua.
# Ở local, key nhập trên web được ưu tiên, nếu không có thì dùng key ở đây.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ép model mặc định (bỏ trống => tự chọn model "nhanh" mới nhất mà key dùng được)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# OPENAI_BASE_URL=     # server tương thích OpenAI (tùy chọn)

# ===== Agent (máy người dùng) =====
# Thường không cần: `feedlens agent --server ... --token ...` tự lưu vào ~/.feedlens/agent.json
FEEDLENS_SERVER=
FEEDLENS_AGENT_TOKEN=

# ===== Database =====
# Bỏ trống => SQLite tại backend/data/feedlens.db
# Postgres: postgresql://user:pass@host/db?sslmode=require (Neon) hoặc xem docker-compose.yml
DATABASE_URL=

# ===== Trình duyệt =====
FEEDLENS_BROWSER_CHANNEL=chrome
FEEDLENS_MAX_POSTS=300
FEEDLENS_DATA_DIR=
